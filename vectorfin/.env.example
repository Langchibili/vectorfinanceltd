EXPO_PUBLIC_ENV=local
# Use 10.0.2.2 for the Android emulator; use this PC's LAN IP on a physical phone.
EXPO_PUBLIC_LAN_IP=10.0.2.2

# Set this for native push tokens after creating/connecting the app to an EAS project.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Production builds must set all four service URLs to HTTPS/WSS-compatible endpoints.
# EXPO_PUBLIC_ENV=production
# EXPO_PUBLIC_FRONTEND_URL=
# EXPO_PUBLIC_BACKEND_URL=
# EXPO_PUBLIC_SOCKET_URL=
# EXPO_PUBLIC_DEVICE_SOCKET_URL=
