{
  "expo": {
    "name": "VectorFin Admin",
    "slug": "vectorfinadmin",
    "scheme": "vectorfinadmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#0A0F1E" },
    "ios": { "bundleIdentifier": "com.vectorfinance.admin", "supportsTablet": false, "infoPlist": { "UIBackgroundModes": ["remote-notification"] } },
    "android": {
      "package": "com.vectorfinance.admin",
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#0A0F1E" },
      "permissions": ["POST_NOTIFICATIONS", "RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true
    },
    "plugins": [
      ["expo-notifications", { "color": "#10B981" }],
      "expo-secure-store",
      "expo-task-manager"
    ],
    "extra": { "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" } }
  }
}
