# Use the same long, random value in backend/.env and sockets/.env.
# The backend client and Socket.IO services use it for trusted event forwarding.
SOCKET_INTERNAL_TOKEN=replace-with-a-long-random-value-in-both-files
BACKEND_URL=http://localhost:1350
MAIN_SOCKET_URL=http://localhost:4000
DEVICE_SOCKET_URL=http://localhost:3008
DEVICESPORT=3008
